# Last.fm recently-played widget (get a key at https://www.last.fm/api)
LASTFM_API_KEY=
# Last.fm username whose listening history is shown
LASTFM_USER=
# Anthropic API key for the drink-horoscope generator
ANTHROPIC_API_KEY=
# Mapbox token for route weather, city suggestions, and the static route map
MAPBOX_ACCESS_TOKEN=
# Finnhub key for the news/stock ticker (server-side only)
FINNHUB_API_KEY=

# NOTE: Never add VITE_-prefixed secrets. Vite inlines VITE_* variables into
# the public JavaScript bundle, exposing them to anyone who visits the site.
# All keys above are read server-side in api/index.js only.

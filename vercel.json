{
  "version": 2,
  "trailingSlash": false,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "redirects": [
    { "source": "/ATourismApp", "destination": "/HikeAwayTours", "permanent": true },
    { "source": "/ReactNativeCreditCardApp", "destination": "/PaperTrail", "permanent": true },
    { "source": "/SnipeIT", "destination": "/Census", "permanent": true },
    { "source": "/ExcelWorkBooks", "destination": "/projects", "permanent": true },
    { "source": "/Geddes_Resume_26.pdf", "destination": "/resumes/John_Geddes_Resume.pdf", "permanent": false },
    { "source": "/resumes/Geddes_AV_Engineer.pdf", "destination": "/resumes/John_Geddes_Resume_AV_Engineer.pdf", "permanent": false },
    { "source": "/resumes/Geddes_Executive_Technician.pdf", "destination": "/resumes/John_Geddes_Resume.pdf", "permanent": false },
    { "source": "/resumes/Geddes_Manager.pdf", "destination": "/resumes/John_Geddes_Resume_Technical_Lead.pdf", "permanent": false },
    { "source": "/resumes/Geddes_Web_Developer.pdf", "destination": "/resumes/John_Geddes_Resume_Software_Engineer.pdf", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/ChessDeck/online/(.*)", "destination": "/ChessDeck/online" },
    { "source": "/((?!api/|assets/).*)", "destination": "/404" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/PaperTrail",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/resumes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
